{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "_postman_id": "6a0f3c2e-8d4b-4f53-9a51-0c6b8e1f7a21",
    "description": "Tests for the Hotel Offer Orchestrator (Express + Temporal + Redis).\n\nStart the stack with `docker-compose up --build`, then run the collection in order (Collection Runner). Set `baseUrl` if the API is not on http://localhost:3000.\n\nThe 'Supplier down simulation' folder switches the mock suppliers off and back on, and ends by restoring both.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health - all up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('Overall status is ok', () => pm.expect(body.status).to.eql('ok'));",
                  "pm.test('Both suppliers are up', () => {",
                  "    pm.expect(body.suppliers['Supplier A'].status).to.eql('up');",
                  "    pm.expect(body.suppliers['Supplier B'].status).to.eql('up');",
                  "});",
                  "pm.test('Redis, Temporal and worker are up', () => {",
                  "    ['redis', 'temporal', 'worker'].forEach((d) => pm.expect(body.dependencies[d].status).to.eql('up'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Health of both suppliers plus Redis, Temporal and the worker. 200 for ok/degraded, 503 for down."
          }
        }
      ]
    },
