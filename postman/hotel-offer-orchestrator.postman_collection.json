    {
      "name": "Hotels",
      "item": [
        {
          "name": "Delhi - overlapping suppliers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Every item has name, price, supplier, commissionPct', () => {",
                  "    pm.response.json().forEach((h) => {",
                  "        pm.expect(h).to.have.all.keys('name', 'price', 'supplier', 'commissionPct');",
                  "        pm.expect(h.price).to.be.a('number');",
                  "        pm.expect(h.supplier).to.be.oneOf(['Supplier A', 'Supplier B']);",
                  "    });",
                  "});",
                  "pm.test('Sorted by price ascending', () => {",
                  "    const prices = pm.response.json().map((h) => h.price);",
                  "    pm.expect(prices).to.eql([...prices].sort((a, b) => a - b));",
                  "});",
                  "",
                  "const hotels = pm.response.json();",
                  "const byName = Object.fromEntries(hotels.map((h) => [h.name, h]));",
                  "pm.test('7 unique hotels (5 overlapping + 1 per supplier)', () => {",
                  "    pm.expect(hotels).to.have.lengthOf(7);",
                  "    pm.expect(new Set(hotels.map((h) => h.name.toLowerCase())).size).to.eql(hotels.length);",
                  "});",
                  "pm.test('Holtin: Supplier B is cheaper (5340 < 6000)', () => {",
                  "    pm.expect(byName['Holtin']).to.eql({ name: 'Holtin', price: 5340, supplier: 'Supplier B', commissionPct: 20 });",
                  "});",
                  "pm.test('Radison: Supplier A is cheaper (5900 < 6150)', () => {",
                  "    pm.expect(byName['Radison']).to.eql({ name: 'Radison', price: 5900, supplier: 'Supplier A', commissionPct: 13 });",
                  "});",
                  "pm.test('Single-supplier hotels are kept', () => {",
                  "    pm.expect(byName['Hyatt Regency'].supplier).to.eql('Supplier A');",
                  "    pm.expect(byName['Lemon Tree'].supplier).to.eql('Supplier B');",
                  "});",
                  "pm.test('Workflow id header is present', () => pm.expect(pm.response.headers.get('X-Workflow-Id')).to.match(/^hotel-search-delhi-/));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
