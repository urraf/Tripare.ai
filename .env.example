# Copy to .env to override defaults. docker-compose reads .env automatically.

# Host ports published by docker-compose
API_PORT=3000
REDIS_PORT=6379
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

LOG_LEVEL=info

# Start with a supplier "down" (can also be toggled at runtime via PUT /admin/suppliers/:id/status)
SUPPLIER_A_DOWN=false
SUPPLIER_B_DOWN=false

# Only used when running the API / worker outside Docker (npm run dev:*)
# PORT=3000
# TEMPORAL_ADDRESS=localhost:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=hotel-offers
# REDIS_URL=redis://localhost:6379
# SUPPLIER_BASE_URL=http://localhost:3000
# SUPPLIER_TIMEOUT_MS=3000
# SUPPLIER_HEALTH_TIMEOUT_MS=2000
# HOTELS_TTL_SECONDS=3600
# WORKFLOW_TIMEOUT_MS=15000
